<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <!-- Set /p:MbmMissingDialogForFiles=false for headless/CI/test builds. The default is true
         for interactive desktop use. -->
    <MbmMissingDialogForFiles Condition="'$(MbmMissingDialogForFiles)' == ''">true</MbmMissingDialogForFiles>
    <MbmCoreFeatureDefines>AUDIO_ENGINE_PORT_AUDIO</MbmCoreFeatureDefines>
    <MbmCoreFeatureDefines Condition="'$(MbmMissingDialogForFiles)' != 'false' and '$(MbmMissingDialogForFiles)' != '0'">$(MbmCoreFeatureDefines);USE_MISSING_DIALOG_FOR_FILES</MbmCoreFeatureDefines>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
