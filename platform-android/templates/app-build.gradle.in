// app/build.gradle — generated by CMake configure_file().
// DO NOT EDIT: edit platform-android/templates/app-build.gradle.in instead.

plugins {
    id 'com.android.application'
}

android {
    namespace '@GAME_PACKAGE@'
    compileSdk 34
    ndkPath '@NDK_ROOT@'

    defaultConfig {
        applicationId '@GAME_PACKAGE@'
        minSdk @ANDROID_NATIVE_API_LEVEL@
        targetSdk 34
        versionCode 1
        versionName "1.0"

        ndk {
            abiFilters @GRADLE_ABI_FILTERS@
        }

        ndkVersion '@ANDROID_NDK_VERSION@'

        externalNativeBuild {
            cmake {
                // Pass all the same flags that were used to generate this project.
                arguments @GRADLE_CMAKE_ARGS@
                cppFlags '-std=c++17 -fPIC'
            }
        }
    }

    externalNativeBuild {
        cmake {
            // Point back at the engine's root CMakeLists.txt.
            path '@CMAKE_SOURCE_DIR@/CMakeLists.txt'
            version '3.25.1+'
        }
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'),
                          'proguard-rules.pro'
        }
        debug {
            debuggable true
            jniDebuggable true
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_11
        targetCompatibility JavaVersion.VERSION_11
    }

    sourceSets {
        main {
            java.srcDirs = ['src/main/java']
            res.srcDirs  = ['src/main/res']
            @GRADLE_ASSETS_SRCDIRS@
        }
    }
}

dependencies {
    // androidx.core is needed for FileProvider (used by the share command).
    // If you do not use it, you can remove the next line ("androidx.core:core:1.13.1")
    implementation "androidx.core:core:1.13.1"
}
